# Leave unset to use same-origin /api proxy (recommended for local dev).
# NEXT_PUBLIC_SHORTLISTR_API_URL=http://127.0.0.1:8787

# Backend URL for Next.js rewrites (server-side proxy target)
SHORTLISTR_API_PROXY=http://127.0.0.1:8787

# Optional bearer token when SHORTLISTR_API_TOKEN is set on the API
NEXT_PUBLIC_SHORTLISTR_API_TOKEN=
