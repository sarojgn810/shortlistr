# ── Generated / deps ────────────────────────────────────────────────────────
node_modules/
# package-lock.json is NOT ignored. Ignoring it made CI fail on every push
# since it was added — setup-node could not resolve its cache path, and
# `npm ci` requires a lock file at all — and it meant a cloner resolved a
# different dependency tree than the one this repo was tested against.
dashboard/node_modules/
dashboard/.next/
dashboard/.env.local
dashboard/tsconfig.tsbuildinfo
.resolved-prompt-*
.update-dismissed
.update-lock
shortlistr-dashboard
.pytest_cache/

# Portable Node (auto-installed by `make start` when system Node is missing)
.tools/

