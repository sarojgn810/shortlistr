# ── shortlistr — environment secrets ────────────────────────────────────────────
# Copy this file to .env, fill in your values, then source it:
#   cp .env.example .env
#   source .env          # or: set -a; source .env; set +a
#
# Alternatively, just run:  python setup.py
# The wizard writes .env for you automatically.

# ── LLM API key ──────────────────────────────────────────────────────────────
# Set in repo root .env OR automation/.env (both are loaded).
# Provider and model are set in config/profile.yml → llm:
SHORTLISTR_LLM_API_KEY=

# ── Gmail App Password ────────────────────────────────────────────────────────
# Create at: https://myaccount.google.com/apppasswords
# Steps: Enable 2FA → App Passwords → Mail → Mac → Generate (16-char code)
GMAIL_APP_PASSWORD=

# ── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── Naukri ────────────────────────────────────────────────────────────────────
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# ── Apify (opt-in cloud scrapers for LinkedIn + Naukri) ───────────────────────
# Free $5 credit is enough for personal use. Enable by adding "apify" under
# sources.enabled in config/profile.yml, then set:
# APIFY_TOKEN=
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=
